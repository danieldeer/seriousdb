# EditorConfig helps keep editor defaults consistent across contributors.
# See https://editorconfig.org/
root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
end_of_line = lf
indent_style = space
insert_final_newline = true
indent_size = 2

[*.{py,pyi,toml}]
indent_size = 4

[*.md]
max_line_length = 100
